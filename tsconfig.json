{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      // حزمة الكاش
      "@core/cache": ["src/libs/cache/index"],
      "@core/cache/*": ["src/libs/cache/*"],

      // حزمة اللوجر
      "@core/logger": ["src/libs/logger/index"],
      "@core/logger/*": ["src/libs/logger/*"],

      // اختصار اختياري لمجلد الموديولات لسهولة الاستيراد الداخلي
      "@modules/*": ["src/modules/*"]
    },

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
